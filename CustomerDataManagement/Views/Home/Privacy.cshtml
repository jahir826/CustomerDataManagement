@{
    ViewData["Title"] = "Privacy Policy";
}
<div >
    <div >
        <div >
            <div class="card-body">

                <h2 class="text-center mb-4">
                    About Customer Data Management System
                </h2>

                <p class="lead text-center">
                    Customer Data Management System is a secure and user-friendly
                    web application developed using ASP.NET Core MVC for managing
                    customer information efficiently.
                </p>

                <hr />

                <p>
                    This application allows users to perform complete customer
                    management operations including adding, updating, deleting,
                    and viewing customer records. The system is designed to
                    simplify customer data handling while ensuring data accuracy
                    and security.
                </p>

                <h4 class="mt-4">Key Features</h4>
                <ul>
                    <li>Customer Registration and Management</li>
                    <li>Complete CRUD Operations</li>
                    <li>Authentication and Authorization using ASP.NET Core Identity</li>
                    <li>Client-side and Server-side Validation</li>
                    <li>Exception Handling and Error Management</li>
                    <li>Entity Framework Core with Code First Approach</li>
                    <li>Database Migrations and Scaffolding</li>
                    <li>Responsive User Interface using Bootstrap</li>
                    <li>Interactive Functionality using JavaScript</li>
                    <li>SQL Server Database Integration</li>
                </ul>

              

                <div class="alert alert-info mt-4">
                    <strong>Project Goal:</strong>
                    To provide an efficient, secure, and scalable solution for
                    managing customer information while demonstrating modern
                    web development practices using the Microsoft .NET ecosystem.
                </div>

            </div>
        </div>
    </div>

    <div class="container mt-5 text-center">
        <h2>Technology Stack</h2>

        <span class="badge bg-primary m-1">ASP.NET Core MVC</span>
        <span class="badge bg-success m-1">C#</span>
        <span class="badge bg-dark m-1">SQL Server</span>
        <span class="badge bg-warning text-dark m-1">JavaScript</span>
        <span class="badge bg-info text-dark m-1">Bootstrap</span>
        <span class="badge bg-secondary m-1">Entity Framework Core</span>
    </div>
    <div class="card mt-4 shadow-sm">
        <div class="card-body text-center">
            <h4>Developer Information</h4>
            <p>
                Developed by <strong>Shekh Jahir</strong>
            </p>
            <p>
                Passionate .NET Developer with experience in
                ASP.NET Core MVC, Entity Framework Core,
                SQL Server, JavaScript, and Bootstrap.
            </p>
        </div>
    </div>
</div>
