@inject SignInManager<IdentityUser> signInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CustomerDataManagement</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVCDHProject.styles.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow"> @*mb-3 *@
            <div class="container-fluid" >
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <a class="navbar-brand d-flex align-items-center"
                       asp-controller="Home"
                       asp-action="Index">

                        <div class="bg-primary rounded-circle d-flex justify-content-center align-items-center"
                             style="width:37px;height:37px;">
                            <i class="fas fa-users"></i>
                        </div>

                        <div class="ms-3">
                            <h4 class="mb-0 fw-bold">CDMS</h4>

                        </div>

                    </a>
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-house me-1"></i> Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                                <i class="fas fa-circle-info me-1"></i> About Us
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">
                                <i class="fas fa-envelope me-1"></i> Contact Us
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Customer" asp-action="DisplayCustomers">
                                <i class="fas fa-users me-1"></i> Customers Details
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (signInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link">  <i class="fas fa-user-circle me-1"></i>@User.Identity.Name</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Logout">  <i class="fas fa-right-from-bracket me-1"></i>Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item" class="fas fa-user-plus me-1">
                                <a class="nav-link" asp-controller="Account" asp-action="Register"> <i class="fas fa-user-plus me-1"></i>Register</a>
                            </li>
                            <li class="nav-item">
                          
                                <a class="nav-link" asp-controller="Account" asp-action="Login">  <i class="fas fa-right-to-bracket me-1"></i> Login</a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid p-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer">
        <div class="container-fluid">
            <div class="row text-center text-md-start">

                <!-- About -->
                <div class="col-md-4 mb-3">
                    <h5>Customer System</h5>
                    <p>Manage your customer data efficiently with our system.</p>
                    <p>
                        Developed by Shekh Jahir | ASP.NET Core MVC | SQL Server
                    </p>
                </div>

                <!-- Links -->
                <div class="col-md-4 mb-3">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a asp-action="Index" asp-controller="Home">Home</a></li>
                        <li><a asp-action="DisplayCustomers" asp-controller="Customer">Add Customer</a></li>
                        <li><a asp-action="DisplayCustomers" asp-controller="Customer">View Customers</a></li>
                    </ul>
                </div>

                <!-- Contact -->
                <div class="col-md-4 mb-3">
                    <h5>Contact</h5>
                    <p>Email: shekhjahir826@gmail.com</p>
                    <p>Phone: +91 8261080635</p>
                </div>

            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>